# Local Python only (Compose does not load this file).
# python-dotenv interpolation is disabled; `$` in FUBO_PASS is kept as-is.
# Prefer FUBO_PASS_B64 when the password contains $ ! ` or spaces:
#   printf '%s' 'my$ecureP@ss' | base64 -w0; echo
FUBO_USER=you@example.com
FUBO_PASS=your-password
# FUBO_PASS_B64=
PORT=7777
HOST=0.0.0.0
EPG_CACHE_SECONDS=3600
EPG_EMPTY_CACHE_SECONDS=120
EPG_DAYS=2
CONFIG_DIR=./config
# Background DRM asset sweep (clean M3U/EPG; does not decrypt DRM)
DRM_SCAN_ON_START=true
DRM_SCAN_CONCURRENCY=1
DRM_SCAN_DELAY_MS=750
DRM_SCAN_MAX_AGE_HOURS=24
DRM_SCAN_INTERVAL_HOURS=24
# Optional: ffmpeg HLS→MPEG-TS remux when Emby/Jellyfin do not share Fubo egress
STREAM_PROXY=false
STREAM_PROXY_MAX=3
# FFMPEG_PATH=ffmpeg
# Optional DRM allow/deny (comma-separated). Prefer config/drm_overrides.json on the volume.
# DRM_DENY_IDS=
# DRM_ALLOW_IDS=
# DRM_DENY_CALL_SIGNS=
# DRM_ALLOW_CALL_SIGNS=
