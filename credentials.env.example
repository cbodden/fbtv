# Copy to the mounted config volume as credentials.env (not the project root).
# Do not wrap values in quotes. Prefer FUBO_PASS_B64 when the password contains $ ! ` or spaces.
#
#   printf '%s' 'my$ecureP@ss' | base64 -w0; echo
#
FUBO_USER=you@example.com
FUBO_PASS_B64=bXkkZWN1cmVQQHNz
# FUBO_PASS=only-use-this-for-alphanumeric-passwords
#
# AUTH_COOLDOWN_SECONDS is a process/Compose env (not required here).
# From 1.0.10+, failed sign-ins cool down password retries (default 1800s).
